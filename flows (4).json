    {
        "id": "51874c48c686e557",
        "type": "function",
        "z": "bec8b2303268ac34",
        "name": "function 4",
        "func": "let currentValue = msg.payload;\n// Previous stored value\nlet lastValue = context.get(\"lastValue\");\n// Existing timer\nlet timer = context.get(\"timer\");\n\n// RESET FROM NODE-RED BUTTON\nif (msg.reset === true)\n{\n    // Clear running timer\n    if (timer)\n    {\n        clearTimeout(timer);\n    }\n\n    // Reset stored values\n    context.set(\"lastValue\", null);\n    context.set(\"timer\", null);\n\n    // Update status\n    node.status({\n        fill: \"blue\",\n        shape: \"dot\",\n        text: \"WATCHDOG RESET\"\n    });\n\n    node.warn(\"MQTT Watchdog Reset\");\n\n    return null;\n}\n// If value changed\nif (currentValue !== lastValue)\n{\n    // Store new value\n    context.set(\"lastValue\", currentValue);\n\n    // Clear old timer\n    if (timer)\n    {\n        clearTimeout(timer);\n    }\n\n    // Start new 3 sec timer\n    timer = setTimeout(function ()\n    {\n        node.error(\"MQTT Watchdog Timeout - No Change for 3 Seconds\");\n\n        // Optional status indication\n        node.status({\n            fill: \"red\",\n            shape: \"ring\",\n            text: \"WATCHDOG TIMEOUT\"\n        });\n\n    }, 3000);\n\n    context.set(\"timer\", timer);\n\n    // Healthy status\n    node.status({\n        fill: \"green\",\n        shape: \"dot\",\n        text: \"WATCHDOG OK\"\n    });\n}\n\n// Echo same value back to MQTT PUB\nreturn {\n    payload: currentValue\n};",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 620,
        "y": 520,
        "wires": [
            [
                "449eb7d0474958ea",
                "a018933f5a0adcea"
            ]
        ]
    },
